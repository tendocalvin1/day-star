# ── Application Configuration ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Database Configuration (PostgreSQL) ──────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=daystar_daycare
DB_USER=postgres
DB_PASSWORD=daystar123

# In production: Database connection URL (e.g. for Render/Supabase)
# DATABASE_URL=postgresql://postgres:daystar123@localhost:5432/daystar_daycare

# ── Authentication (JWT) ───────────────────────────────────────────────────
JWT_SECRET=daystar_dev_secret_change_in_production_2025
# Access token expiration (short-lived)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token expiration (longer-lived)
JWT_REFRESH_EXPIRES_IN=7d

# ── Redis & Caching Configuration ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Notifications & Job Queues ─────────────────────────────────────────────
# Set to 'true' to run BullMQ job processor workers in this process (useful for development)
RUN_QUEUE_WORKERS=true
